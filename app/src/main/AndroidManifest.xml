<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
            The live application ID. The SDK refuses to start without this value,
            and it cannot read AdConfig, so the same string is stated in both
            places and the two have to be kept identical.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6520630912116541~7739652502" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HalfMeasures">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Theme.HalfMeasures" />

        <activity
            android:name=".DevSettingsActivity"
            android:exported="false"
            android:label="Developer settings"
            android:theme="@style/Theme.HalfMeasures" />

        <activity
            android:name=".InstructionsActivity"
            android:exported="false"
            android:label="How to play"
            android:theme="@style/Theme.HalfMeasures" />
    </application>

</manifest>
