<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon, with the whole mark in the background layer and nothing on top.

    The logo is already an app-icon shape - a rounded square that fills its own
    frame - so the right treatment is to let it bleed past the launcher's mask and
    be cut to whatever shape that launcher wants, exactly like every other icon on
    the phone. Putting it in the foreground over a transparent background is what
    produced the black frame: a launcher given a transparent adaptive background
    fills it in itself, and the mark then sat shrunk inside that fill.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
