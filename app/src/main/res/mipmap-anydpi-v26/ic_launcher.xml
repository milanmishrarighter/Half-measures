<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon. The launcher masks these two layers to its own shape - circle,
    squircle, teardrop - so the mark is inset well inside the safe zone rather than
    drawn to the edges, where a round mask would cut it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
